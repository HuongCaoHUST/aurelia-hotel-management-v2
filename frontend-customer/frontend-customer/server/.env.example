# API port for web and Expo clients
API_PORT=4000
API_HOST=0.0.0.0

# Change this before using the admin endpoint outside your local machine
ADMIN_API_KEY=replace-with-a-long-random-secret

# During local development, * allows Vite and Expo Go to call the API.
# For deployment, replace * with your actual site origin(s), comma-separated.
ALLOWED_ORIGINS=*
